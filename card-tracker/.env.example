# Copy to .env.local and fill in.

# Claude API key, used to identify cards from photos.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# eBay developer app keys (Production keyset), used for price lookups.
# https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: marketplace to search (default EBAY_US).
EBAY_MARKETPLACE_ID=EBAY_US
# Optional: set to https://api.sandbox.ebay.com if using Sandbox keys.
EBAY_API_BASE=

# Optional: where the SQLite database and photos are stored (default ./data).
DATA_DIR=
